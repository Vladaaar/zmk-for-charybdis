#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        comma: comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>, <&macro_press>;

            label = "COMMA";
        };
    };

    combos {
        compatible = "zmk,combos";

        Toggle_game {
            bindings = <&tog 5>;
            key-positions = <26 15 28>;
        };

        MB1_left {
            bindings = <&mkp MB1>;
            key-positions = <40 39>;
        };

        MB2_left {
            bindings = <&mkp MB2>;
            key-positions = <39 38>;
        };

        MB3_left {
            bindings = <&mkp MB3>;
            key-positions = <40 39 38>;
        };

        MB1_right {
            bindings = <&mkp MB1>;
            key-positions = <43 44>;
        };

        MB2_right {
            bindings = <&mkp MB2>;
            key-positions = <44 45>;
        };

        MB3_right {
            bindings = <&mkp MB3>;
            key-positions = <43 44 45>;
        };

        up {
            bindings = <&kp UP>;
            key-positions = <15 20>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <26 31>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <27 32>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <28 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1       &kp N2          &kp N3           &kp N4        &kp N5                    &kp N6               &kp N7        &kp N8      &kp N9           &kp N0               &kp MINUS
&kp TAB         &kp Q        &kp W           &kp E            &kp R         &mt GRAVE T               &kp Y                &kp U         &kp I       &kp O            &kp P                &mt RIGHT_BRACKET LEFT_BRACKET
&kp CAPS        &mt LCTRL A  &mt LEFT_ALT S  &mt LCMD D       &mt LSHIFT F  &kp G                     &kp H                &mt RSHIFT J  &mt RCMD K  &mt RIGHT_ALT L  &mt RCTRL SEMI       &kp SQT
&kp LEFT_SHIFT  &kp Z        &kp X           &kp C            &kp V         &kp B                     &kp N                &kp M         &kp COMMA   &kp DOT          &mt BACKSLASH SLASH  &mo 3
                                             &lt 2 BACKSPACE  &lt 1 SPACE   &lt 3 DEL                 &mt PERIOD KP_COMMA  &lt 1 SPACE
                                                              &lt 4 TAB     &mt LC(LEFT_ALT) GLOBE    &kp ENTER
            >;
        };

        NAV {
            bindings = <
&trans     &kp F1    &kp F2  &kp F3    &kp F4      &kp F5         &kp F6     &kp F7    &kp F8     &kp F9                &kp F10                &kp EQUAL
&kp TILDE  &kt EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER
&trans     &trans    &trans  &trans    &trans      &trans         &trans     &kp LEFT  &kp DOWN   &kp UP                &kp RIGHT              &trans
&trans     &trans    &trans  &trans    &trans      &trans         &trans     &kp BSPC  &trans     &trans                &trans                 &trans
                             &trans    &trans      &To0_macro     &mkp LCLK  &trans
                                       &trans      &trans         &trans
            >;
        };

        MEDIA {
            bindings = <
&trans      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_PRV  &bt BT_NXT      &trans            &bt BT_CLR    &trans  &bt BT_CLR_ALL
&bl BL_TOG  &bl BL_DEC     &bl BL_INC     &trans        &trans        &trans          &trans      &trans          &trans            &trans        &trans  &trans
&trans      &kp C_BRI_DEC  &kp C_BRI_INC  &trans        &trans        &trans          &trans      &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans  &trans
&trans      &trans         &trans         &trans        &trans        &trans          &trans      &kp K_MUTE      &kp C_VOL_DN      &kp C_VOL_UP  &trans  &trans
                                          &trans        &trans        &trans          &trans      &trans
                                                        &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };

        Game {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp Q   &kp W   &kp E   &kp R     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp A   &kp S   &kp D   &kp F     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp Z   &kp X   &kp C   &kp V     &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
