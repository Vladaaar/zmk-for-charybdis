#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 3>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        parentheses: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N9) &kp LS(N0) &kp LEFT_ARROW>;
            label = "PARENTHESES";
        };

        sym_on_another_layout: octothorp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp LC(SPACE) &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp LC(SPACE)>;

            label = "OCTOTHORP";
        };

        momentary_change_layout: change_layout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(SPACE)>,
                <&macro_pause_for_release>,
                <&kp LC(SPACE)>;

            label = "CHANGE_LAYOUT";
        };

        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "BRACKETS";
        };

        guillemets: guillemets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(RIGHT_BRACKET) &kp LS(LA(RIGHT_BRACKET)) &kp LEFT_ARROW>;
            label = "GUILLEMETS";
        };

        strikethrough: strikethrough {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp TILDE &kp TILDE &kp LG(V) &kp TILDE &kp TILDE>;
            label = "STRIKETHROUGH";
        };
    };

    combos {
        compatible = "zmk,combos";

        Toggle_game {
            bindings = <&tog 6>;
            key-positions = <26 15 28>;
        };

        MB1_left {
            bindings = <&mkp MB1>;
            key-positions = <40 39>;
        };

        MB2_left {
            bindings = <&mkp MB2>;
            key-positions = <39 38>;
        };

        MB3_left {
            bindings = <&mkp MB3>;
            key-positions = <40 38>;
        };

        MB1_right {
            bindings = <&mkp MB1>;
            key-positions = <43 44>;
        };

        MB2_right {
            bindings = <&mkp MB2>;
            key-positions = <44 45>;
        };

        MB3_right {
            bindings = <&mkp MB3>;
            key-positions = <43 45>;
        };

        up {
            bindings = <&kp UP>;
            key-positions = <15 20>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <26 31>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <27 32>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <28 33>;
        };
    };

    behaviors {
        symbols_on_hold: symbols_on_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "SYMBOLS_ON_HOLD";
            bindings = <&parentheses>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        another_lang_on_hold: another_lang_on_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "ANOTHER_LANG_ON_HOLD";
            bindings = <&momentary_change_layout>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        parentheses_on_hold: parentheses_on_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "PARENTHESES_ON_HOLD";
            bindings = <&parentheses>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        brackets_on_hold: brackets_on_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BRACKETS_ON_HOLD";
            bindings = <&brackets>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        guillemets_on_hold: guillemets_on_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "GUILLEMETS_ON_HOLD";
            bindings = <&guillemets>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lang: lang {
            compatible = "zmk,behavior-tap-dance";
            label = "LANG";
            #binding-cells = <0>;
            bindings = <&another_lang_on_hold 0 LC(SPACE)>, <&kp LA(LCTRL)>;
        };

        shift_dance: shift_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_DANCE";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC   &mt LS(N1) NUMBER_1  &mt LS(N2) NUMBER_2  &mt LS(NUMBER_3) NUMBER_3  &mt LS(N4) NUMBER_4  &mt LS(N5) NUMBER_5    &mt RS(N6) NUMBER_6  &mt RS(N7) NUMBER_7  &mt RS(N8) NUMBER_8          &parentheses_on_hold 0 N9  &brackets_on_hold 0 NUMBER_0  &mt LS(LA(MINUS)) MINUS
&kp UP    &mt LS(LCTRL) Q      &mt LS(LEFT_ALT) W   &mt LS(LCMD) E             &kp R                &mt GRAVE T            &kp Y                &kp U                &mt RS(RCMD) I               &mt RS(RIGHT_ALT) O        &mt RS(RCTRL) P               &mt RIGHT_BRACKET LEFT_BRACKET
&kp DOWN  &mt LCTRL A          &mt LEFT_ALT S       &mt LCMD D                 &mt LSHIFT F         &kp G                  &kp H                &mt RSHIFT J         &mt RCMD K                   &mt RIGHT_ALT L            &mt RCTRL SEMI                &lt 5 SQT
&kp LEFT  &mt LG(Z) Z          &mt LG(X) X          &mt LG(C) C                &mt LG(V) V          &kp B                  &kp N                &kp M                &guillemets_on_hold 0 COMMA  &lt 4 DOT                  &mt BACKSLASH SLASH           &kp RIGHT
                                                    &lt 1 BACKSPACE            &lt 2 SPACE          &lang                  &lt 2 LS(SLASH)      &lt 1 SPACE
                                                                               &lt 3 TAB            &shift_dance           &lt 3 RET
            >;
        };

        SYMBOLS_FUNC {
            bindings = <
&kp GRAVE  &kp F1    &kp F2   &kp F3    &kp F4      &kp F5         &kp F6        &kp F7       &kp F8        &kp F9                &kp F10                &kp EQUAL
&kp TILDE  &kp EXCL  &kp AT   &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET     &kp AMPS     &kp ASTRK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER
&kp LBKT   &trans    &trans   &trans    &trans      &kp PIPE       &kp QUESTION  &trans       &trans        &trans                &trans                 &kp RBKT
&kp SLASH  &kp F11   &kp F12  &kp F13   &kp F14     &kp LT         &kp GT        &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY       &kp KP_DIVIDE          &kp BSLH
                              &trans    &trans      &trans         &trans        &kp SPACE
                                        &trans      &trans         &trans
            >;
        };

        NAV_EDIT {
            bindings = <
&trans  &trans     &trans     &trans      &trans     &trans       &trans                           &trans         &trans         &trans       &trans     &trans
&trans  &trans     &trans     &trans      &trans     &trans       &trans                           &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &trans     &trans     &trans      &trans     &trans       &mt LG(LEFT) LA(LEFT_ARROW)      &kp LEFT       &kp DOWN       &kp UP       &kp RIGHT  &mt LG(RIGHT) LA(RIGHT)
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)   &kp LG(V)  &kp LG(B)    &mt LG(BACKSPACE) LA(BACKSPACE)  &kp BACKSPACE  &kp INS        &kp LC(T)    &kp DEL    &mt LG(DEL) LA(DEL)
                              &kp DELETE  &trans     &trans       &trans                           &trans
                                          &trans     &trans       &trans
            >;
        };

        MEDIA {
            bindings = <
&trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3          &bt BT_SEL 4       &bt BT_PRV       &bt BT_NXT       &trans            &bt BT_CLR       &trans           &trans
&rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI       &rgb_ug RGB_EFR    &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI   &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(248,100,66)
&bl BL_TOG       &kp C_BRI_DEC    &kp C_BRI_INC    &kp K_APP        &trans                &trans             &trans           &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT       &kp C_VOL_DN     &kp C_VOLUME_UP
&trans           &trans           &trans           &kp LS(LG(N7))   &kp LG(LS(NUMBER_4))  &trans             &trans           &trans           &trans            &trans           &trans           &trans
                                                   &trans           &trans                &trans             &trans           &trans
                                                                    &trans                &trans             &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        Game {
            bindings = <
&trans          &kp NUMBER_1    &kp N2  &kp N3  &kp N4  &kp N5    &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB         &kp TAB         &kp Q   &kp W   &kp E   &kp R     &trans  &trans  &trans  &trans  &trans  &trans
&none           &none           &kp A   &kp S   &kp D   &kp F     &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V     &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans  &trans    &trans  &trans
                                                &trans  &trans    &trans
            >;
        };
    };
};
