#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 2>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 3>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        comma: comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>, <&macro_press>;

            label = "COMMA";
        };
    };

    combos {
        compatible = "zmk,combos";

        Toggle_game {
            bindings = <&tog 6>;
            key-positions = <26 15 28>;
        };

        MB1_left {
            bindings = <&mkp MB1>;
            key-positions = <40 39>;
        };

        MB2_left {
            bindings = <&mkp MB2>;
            key-positions = <39 38>;
        };

        MB3_left {
            bindings = <&mkp MB3>;
            key-positions = <40 39 38>;
        };

        MB1_right {
            bindings = <&mkp MB1>;
            key-positions = <43 44>;
        };

        MB2_right {
            bindings = <&mkp MB2>;
            key-positions = <44 45>;
        };

        MB3_right {
            bindings = <&mkp MB3>;
            key-positions = <43 44 45>;
        };

        up {
            bindings = <&kp UP>;
            key-positions = <15 20>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <26 31>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <27 32>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <28 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC   &kp N1       &kp N2          &kp N3           &kp N4        &kp N5                   &kp N6              &kp N7        &kp N8       &kp N9           &kp N0               &mt LS(LA(MINUS)) MINUS
&kp TAB   &kp Q        &kp W           &kp E            &kp R         &mt GRAVE T              &kp Y               &kp U         &kp I        &kp O            &kp P                &mt RIGHT_BRACKET LEFT_BRACKET
&kp CAPS  &mt LCTRL A  &mt LEFT_ALT S  &mt LCMD D       &mt LSHIFT F  &kp G                    &kp H               &mt RSHIFT J  &mt RCMD K   &mt RIGHT_ALT L  &mt RCTRL SEMI       &kp SQT
&kp LEFT  &kp Z        &kp X           &kp C            &kp V         &kp B                    &kp N               &kp M         &lt 4 COMMA  &lt 5 DOT        &mt BACKSLASH SLASH  &kp RIGHT
                                       &lt 2 BACKSPACE  &lt 1 SPACE   &lt 4 DEL                &mt K_PASTE K_COPY  &lt 1 SPACE
                                                        &lt 3 TAB     &mt LC(LEFT_ALT) CAPS    &kp ENTER
            >;
        };

        NAV {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans     &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        SYMBOLS_FUNC {
            bindings = <
&trans     &kp F1    &kp F2   &kp F3    &kp F4      &kp F5         &kp F6     &kp F7    &kp F8     &kp F9                &kp F10                &kp EQUAL
&kp TILDE  &kp EXCL  &kp AT   &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER
&kp LBKT   &trans    &trans   &trans    &trans      &trans         &trans     &trans    &trans     &trans                &trans                 &kp RBKT
&kp SLASH  &kp F11   &kp F12  &kp F13   &kp F14     &kp F15        &kp F16    &kp F17   &kp F18    &kp F19               &kp F20                &kp BSLH
                              &trans    &trans      &To0_macro     &mkp LCLK  &trans
                                        &trans      &trans         &trans
            >;
        };

        MEDIA {
            bindings = <
&trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &bt BT_PRV       &bt BT_NXT       &trans            &bt BT_CLR       &trans           &bt BT_CLR_ALL
&rgb_ug RGB_ON   &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFR    &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI   &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(248,100,66)
&rgb_ug RGB_OFF  &kp C_BRI_DEC    &kp C_BRI_INC    &trans           &kp C_AC_HOME    &trans             &trans           &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT       &trans           &trans
&rgb_ug RGB_TOG  &trans           &trans           &trans           &trans           &trans             &trans           &kp K_MUTE       &kp C_VOL_DN      &kp C_VOL_UP     &trans           &trans
                                                   &trans           &trans           &trans             &trans           &trans
                                                                    &trans           &trans             &trans
            >;
        };

        MEDIA {
            bindings = <
&trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &bt BT_PRV       &bt BT_NXT       &trans            &bt BT_CLR       &trans           &bt BT_CLR_ALL
&rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFR    &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI   &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(248,100,66)
&trans           &kp C_BRI_DEC    &kp C_BRI_INC    &trans           &kp C_AC_HOME    &trans             &trans           &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT       &trans           &trans
&trans           &trans           &trans           &trans           &trans           &trans             &trans           &kp K_MUTE       &kp C_VOL_DN      &kp C_VOL_UP     &trans           &trans
                                                   &trans           &trans           &trans             &trans           &trans
                                                                    &trans           &trans             &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
