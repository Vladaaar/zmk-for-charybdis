#include "charybdis.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>,
                <&gpio0 29 GPIO_ACTIVE_HIGH>,
                <&gpio0 9 GPIO_ACTIVE_HIGH>,
                <&gpio1 0 GPIO_ACTIVE_HIGH>,
                <&gpio0 11 GPIO_ACTIVE_HIGH>,
                <&gpio1 4 GPIO_ACTIVE_HIGH>;
};

// trackball
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";  // ← ИЗМЕНИЛ на -alt
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // ← 6 — стандарт для Charybdis right
        cpi = <600>;  // ← можно изменить на своё

        // ←←← ОБЯЗАТЕЛЬНЫЕ для badjeff-драйвера
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        force-awake;  

        swap-xy;      
        invert-x;
        invert-y;
    };
};


// RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <27>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

/ {
    // 1. Описываем процессоры ввода
    // Процессор для превращения движения Y в скролл (Wheel)
    ib_scroll_mapper: ib_scroll_mapper {
        compatible = "zmk,input-processor-code-mapper";
        #binding-cells = <0>;
        map {
            // Исходный код -> Целевой код
            <INPUT_REL_Y INPUT_REL_WHEEL>
            <INPUT_REL_X INPUT_REL_HWHEEL>
        };
    };

    // Процессор для масштабирования (чувствительности)
    ib_scroll_scaler: ib_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #binding-cells = <2>; // Ожидает multiplier и divisor
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    };

    // 2. Настраиваем листенер, который всё это объединяет
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        // Слой 4 — это твой слой скролла
        // Процессоры выполняются по порядку сверху вниз
        scroller {
            layers = <4>;
            input-processors 
                = <&ib_scroll_mapper>
                , <&ib_scroll_scaler 1 15>; // Здесь задаем скорость (1 к 15)
        };
    };
};
