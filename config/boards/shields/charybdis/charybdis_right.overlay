#include "charybdis.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>,
                <&gpio0 29 GPIO_ACTIVE_HIGH>,
                <&gpio0 9 GPIO_ACTIVE_HIGH>,
                <&gpio1 0 GPIO_ACTIVE_HIGH>,
                <&gpio0 11 GPIO_ACTIVE_HIGH>,
                <&gpio1 4 GPIO_ACTIVE_HIGH>;
};

// trackball
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";  // ← ИЗМЕНИЛ на -alt
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // ← 6 — стандарт для Charybdis right
        cpi = <600>;  // ← можно изменить на своё

        // ←←← ОБЯЗАТЕЛЬНЫЕ для badjeff-драйвера
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        force-awake;  

        swap-xy;      
        invert-x;
        invert-y;
    };
};


// RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <27>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };

    // 1. Mapper: преобразует X/Y → wheel (вертикальный скролл)
    scroll_mapper: scroll_mapper {
        compatible = "zmk,input-processor";
        label = "XY to Scroll Mapper";
        #binding-cells = <0>;

        device = <&trackball>;
        layers = <4>;                           // твой scroll-layers слой (индекс 4)

        // Используем предопределённый mapper (если подключены input/processors.dtsi)
        // Или явно:
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_Y>;                  // берём только вертикальное движение
        map-to = <INPUT_REL_WHEEL>;             // → wheel
        invert = <0>;                           // направление скролла
    };

    // 2. Scaler: регулирует скорость скролла (чтобы не было слишком медленно/быстро)
    scroll_scaler: scroll_scaler {
        compatible = "zmk,input-processor";
        label = "Scroll Scaler";
        #binding-cells = <0>;

        device = <&trackball>;
        layers = <4>;

        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL>;
        multiplier = <15>;                      // основной масштаб (10–30)
        divisor = <1>;                          // обычно 1, можно увеличить для плавности
    };

    // 3. Transform: инверсия/своп, если нужно (опционально)
    scroll_transform: scroll_transform {
        compatible = "zmk,input-processor";
        label = "Scroll Transform";
        #binding-cells = <0>;

        device = <&trackball>;
        layers = <4>;

        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL>;
        transform = <INPUT_TRANSFORM_WHEEL_INVERT>;  // если скролл в обратную сторону
        // Или <INPUT_TRANSFORM_WHEEL_SWAP> если нужен горизонтальный скролл
    };
};
